# Contact form email delivery (used by server/index.mjs, never by the frontend).
# Copy to .env for local testing; set the same keys in Render > Environment.

# API key from https://resend.com (API Keys page). Keep it secret.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives portfolio messages.
CONTACT_TO_EMAIL=you@example.com

# Optional: a sender on a domain verified in Resend. Without it, Resend's test
# sender is used, which only delivers to the email that owns the Resend account.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
